# Copy to .env and adjust. .env is gitignored — never commit real values.

# development | production
# Controls the CORS allow-list: development permits the local dev origins
# below, production permits FRONTEND_URL only.
ENVIRONMENT=development

# SQLAlchemy connection string.
# Local:      sqlite:///./urls.db
# Production: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./urls.db

# Public origin of this service. Short links are built from it, so it must
# match how users reach the app or every link handed out will be wrong.
BACKEND_URL=http://localhost:8000

# Origin allowed through CORS in production.
FRONTEND_URL=http://localhost:3000

# Port uvicorn binds when running `python main.py`.
PORT=8000
