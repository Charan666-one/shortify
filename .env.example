# Copy to .env and adjust. .env is gitignored — never commit real values.

# development | production
# Controls the CORS allow-list: development permits the local dev origins,
# production permits FRONTEND_URL only.
ENVIRONMENT=development

# SQLAlchemy connection string.
# Local:      sqlite:///./urls.db
# Production: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./urls.db

# Public origin of this service. Short links are built from it, so it must
# match how users reach the app or every link handed out will be wrong.
BACKEND_URL=http://localhost:8000

# Origin allowed through CORS in production.
FRONTEND_URL=http://localhost:3000

# Port uvicorn binds when running `python main.py`.
PORT=8000

# Days before a new link stops resolving. 0 disables expiry entirely.
# Callers can override per link with "expires_in_days" (0–3650).
LINK_TTL_DAYS=365

# Shorten requests allowed per client per minute. 0 disables the limit.
# Counted per process: behind N workers the effective limit is N times this.
RATE_LIMIT_PER_MINUTE=20

# Set true ONLY when a proxy you control sets X-Forwarded-For. Enabled without
# one, any client can spoof its address and walk past the rate limit.
TRUST_PROXY_HEADERS=false
